# Kopiér til .env og udfyld for at aktivere live-data og backend.

# Forsøg live-kald mod åbne API'er (CVR m.fl.). Default: false (mock-data).
# Bemærk: live CVR-kald fra browseren kræver typisk en backend-proxy pga. CORS.
VITE_USE_LIVE_DATA=false

# Supabase (backend). Tomme = appen kører på localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
