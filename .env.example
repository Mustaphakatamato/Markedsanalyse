# Kopiér til .env og udfyld. Begge værdier er påkrævede — appen kalder alle
# eksterne datakilder (TED, CVR, Erhvervsstyrelsen) gennem Supabase Edge
# Functions, både lokalt og i produktion.
#
# Værdierne findes i Supabase-dashboardet under Project Settings → API.
# Publishable-nøglen er offentlig og hører hjemme i browser-bundlet; den giver
# ingen adgang til data, den forhindrer blot at funktionerne kan bruges som
# åben proxy af tilfældige. Læg ALDRIG service_role-nøglen i en VITE_-variabel
# — alt med det præfiks ender i den byggede JavaScript-fil.

VITE_SUPABASE_URL=https://dit-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Kun til indlæsningsscripts og den daglige synk — ALDRIG med VITE_-præfiks.
# ---------------------------------------------------------------------------
# Service-nøglen går uden om RLS og kan læse og slette alt. Findes i Supabase
# under Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (sbp_…) til Management API'et. Bruges til at køre
# migrationer, når der hverken er psql eller supabase CLI på maskinen.
SUPABASE_ACCESS_TOKEN=
# Datafordeleren (CVR-indekset).
DATAFORDELER_API_KEY=
# udbud.dk's eksterne API. Brugeren skal have rollen MU_API_DATASYNK.
UDBUD_DK_BRUGER=
UDBUD_DK_PASSWORD_PROD=
UDBUD_DK_PASSWORD_DEMO=

# ---------------------------------------------------------------------------
# Kun i Vercels miljø, ikke lokalt.
# ---------------------------------------------------------------------------
# Vercel sender den selv som `Authorization: Bearer` til cron-jobbet i
# api/synk-udbud.js. Er den ikke sat, henter endepunktet INTET og svarer 500 —
# et åbent endepunkt kunne bruges til at starte en times hentning fra udbud.dk
# i vores navn. Den daglige synk kræver også de fire variabler ovenfor:
# VITE_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, UDBUD_DK_BRUGER og
# UDBUD_DK_PASSWORD_PROD.
CRON_SECRET=
